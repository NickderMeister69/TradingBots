# Vorlage: Diese Datei kopieren und die Kopie ".env" nennen. Dann die Werte eintragen.
# Die .env NIEMALS auf GitHub hochladen oder weitergeben (sie steht in .gitignore).
# Fuer den Simulationsmodus (mode: paper) braucht man hier GAR NICHTS.

# --- Binance (fuer mode: testnet = Demo-Konto, oder mode: live = Echtgeld) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Bybit EU (nur fuer config_bybit.yaml mit mode: live) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Kraken Futures (nur fuer Kraken-Configs mit mode: live) ---
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=

# --- Telegram-Meldungen (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Passwort fuers Dashboard vom Handy aus (optional, nur mit Tailscale) ---
DASHBOARD_PASSWORD=

# --- Echtgeld-Freigabe: nur auf JA setzen, wenn du wirklich mit echtem Geld handeln willst ---
LIVE_CONFIRM=
